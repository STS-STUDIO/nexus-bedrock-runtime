+// Nexus: our statically-linked curl uses a custom OpenSSL whose baked-in OPENSSLDIR has no CA
+// bundle, so EVERY https request failed TLS verification (the game's profile/store/Xbox screens
+// spun forever, and pre-fix the failed-callback path aborted the game). Point curl at macOS's
+// system CA bundle, which every macOS ships at /etc/ssl/cert.pem.
+void nexus_curl_setup_cainfo(void *curl) {
+    static const bool has_system_pem = access("/etc/ssl/cert.pem", R_OK) == 0;
+    if(has_system_pem) {
+        curl_easy_setopt(curl, CURLOPT_CAINFO, "/etc/ssl/cert.pem");
+    }
+}
