# Patch 0007 — headless Google credentials (no *NIX credential window)
# File: mcpelauncher-core/src/minecraft_utils.cpp
#
# requestGoogleCredentials() used to ALWAYS fork mcpelauncher-ui-qt (the "Request Google Credentials
# / UNOFFICIAL *NIX LAUNCHER" window). Now it first reads a Nexus-written file and hands the token
# straight to the DRM mod — no fork, no window. The launcher's seed_engine_credentials() writes the
# file (~/Library/Application Support/mcpelauncher/nexus-google-cred, one line "email:token").
#
# Reconstructed from the session edits; apply by hand during a rebuild.

--- a/mcpelauncher-core/src/minecraft_utils.cpp
+++ b/mcpelauncher-core/src/minecraft_utils.cpp
@@ add include @@
 #include <log.h>
+#include <fstream>
 #include <FileUtil.h>

@@ at the very start of requestGoogleCredentials(), before __builtin_return_address @@
 static void requestGoogleCredentials(void (*onsuccess)(GoogleCredentials creds), void (*onfailure)(const char* error)) {
+    // Nexus: hand the DRM mod Google credentials HEADLESSLY, from a file the launcher writes
+    // ("email:token"), so we never fork the mcpelauncher-ui-qt "*NIX LAUNCHER" consent window.
+    // Falls through to the legacy helper only if the file is missing or malformed.
+    {
+        std::string credPath;
+        if (const char* env = getenv("NEXUS_GOOGLE_CRED")) {
+            credPath = env;
+        } else if (const char* home = getenv("HOME")) {
+            credPath = std::string(home) + "/Library/Application Support/mcpelauncher/nexus-google-cred";
+        }
+        if (!credPath.empty()) {
+            std::ifstream f(credPath);
+            if (f) {
+                std::string line;
+                std::getline(f, line);
+                while (!line.empty() && (line.back()=='\n'||line.back()=='\r'||line.back()==' '||line.back()=='\t'))
+                    line.pop_back();
+                size_t sep = line.find(':');
+                if (sep != std::string::npos && sep + 1 < line.size()) {
+                    std::string email = line.substr(0, sep);
+                    std::string token = line.substr(sep + 1);
+                    Log::info("Launcher", "Nexus: seeded Google credentials for %s (no helper window)", email.c_str());
+                    onsuccess({email.c_str(), token.c_str()});
+                    return;
+                }
+            }
+        }
+    }
     const void* caller_addr = __builtin_return_address(0);
     /* ... unchanged: legacy fork of mcpelauncher-ui-qt --request-google-credentials ... */
